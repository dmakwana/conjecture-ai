{
  "name": "duck-invariant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "mkdir -p out && concurrently -n next,worker -c cyan,magenta \"npm:dev:next\" \"npm:dev:worker\"",
    "dev:next": "next dev",
    "dev:worker": "wrangler dev --port 8787",
    "build": "next build",
    "preview": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@codemirror/lang-sql": "6.10.0",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@uiw/react-codemirror": "4.25.11",
    "apache-arrow": "17.0.0",
    "hono": "4.13.7",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260907.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11",
    "wrangler": "4.129.1"
  }
}
