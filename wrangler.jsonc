{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "conjecture-ai",
  // Assets only: there is no Worker script and no server code. Claude is
  // called straight from the browser with the user's own API key.
  "compatibility_date": "2026-09-01",
  // Every extra public hostname is another copy of the site to keep track of.
  // Preview URLs publish <version>-conjecture-ai.<subdomain>.workers.dev.
  "preview_urls": false,
  "assets": {
    // `next build` with output:'export' writes here.
    "directory": "./out",
    "not_found_handling": "single-page-application"
  }
}
